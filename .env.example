# Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_DB=app72h
POSTGRES_USER=app72h
POSTGRES_PASSWORD=change-me

# API
API_PUBLIC_URL=https://api.example.com

# Map source for extracts: local file after SSD move, or a Protomaps build URL before that
# (see https://maps.protomaps.com/builds/). Local path is inside the container.
MAP_SOURCE=/maps/cz.pmtiles

# Temporary API key for map endpoints until user auth (M3). Generate: openssl rand -hex 24
DEV_API_KEY=

# Login codes: key for hashing codes. Generate: openssl rand -hex 32
AUTH_SECRET=

# Email for login codes: log (dev, prints only) | brevo | resend
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=
